{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gameelkisai",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  // Seluruh file statis (html/js/css/gambar) dilayani dari root proyek.
  // Worker hanya jalan untuk /ws/* (duel online), sisanya langsung ke aset statis.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*"]
  },
  // Satu Durable Object per room duel (kode 4 angka).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
